# Server binding
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# CORS / socket origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable CSP once assets are CSP-clean (0/1)
ENABLE_CSP=0

# Optional: session duration in hours
SESSION_TTL_HOURS=12

# First admin account (only used on a fresh install with no admin users).
# If QFLOW_ADMIN_PASSWORD is empty, a random password is generated and printed ONCE
# to the server log (journalctl -u qflow / docker compose logs) and must be changed at first login.
QFLOW_ADMIN_USERNAME=admin
QFLOW_ADMIN_PASSWORD=

# Where the SQLite database, logs and backups are stored (default: ./data next to server.js)
# QFLOW_DATA_DIR=/var/lib/qflow

# Which reverse proxies may set X-Forwarded-For (used for rate limiting, login lockout and ALLOWED_API_IPS).
# Default: loopback, linklocal, uniquelocal  (a proxy on the same host or on a private network)
# Examples: TRUST_PROXY=false            (no proxy, clients connect directly)
#           TRUST_PROXY=192.168.1.10     (only this proxy)
#           TRUST_PROXY=1                (exactly one proxy hop, whatever its address)
TRUST_PROXY=

# Maximum number of waiting tickets before new tickets are refused (protects against ticket spam)
MAX_WAITING_TICKETS=500

# Session Secret for OAuth (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional log/backup retention overrides
LOG_RETENTION_DAYS=14
BACKUP_RETENTION_DAYS=30

# API keys (comma-separated) for integrations that call /api/print-ticket without an admin login.
# Send the key in the X-API-Key header. The endpoint only prints on printers configured in the admin panel.
# Generate strong random tokens using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=

# API Security - IP whitelist for API access (comma-separated IPs or CIDR blocks)
# Examples: 192.168.1.0/24,10.0.0.5
# Leave empty to allow all IPs (default)
ALLOWED_API_IPS=

# OAuth / OIDC Authentication
# These settings can also be configured via the admin interface
# Leave empty to configure through admin UI or to disable external authentication

# Google OAuth (for Google Workspace)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Generic OIDC Provider
# Examples: Entra ID (Azure AD), Keycloak, Auth0, Okta
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:3000/auth/oidc/callback
