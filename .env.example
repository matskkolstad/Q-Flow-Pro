# Q-Flow Pro settings. Copy to .env (systemd loads it via EnvironmentFile; for a manual run use
# `node --env-file=.env server.js`). Everything else is configured in the admin panel.

# Server binding. 0.0.0.0 = all addresses. A specific IP means the server does not answer on localhost.
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Time zone for opening hours, the nightly reset/backup and statistics
TZ=Europe/Oslo

# Where the SQLite database, logs and backups are stored (default: ./data next to server.js)
QFLOW_DATA_DIR=/var/lib/qflow

# Extra origins allowed to call the API/real-time connection from another address (comma-separated),
# e.g. the Vite dev server. Pages served by Q-Flow itself always work.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Keeps sign-ins with Google/OIDC valid across restarts (REQUIRED in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a staff sign-in lasts, in hours
SESSION_TTL_HOURS=12

# First admin account (only used on a fresh install with no admin users).
# If QFLOW_ADMIN_PASSWORD is empty, a random password is generated and printed ONCE
# to the server log (journalctl -u qflow) and must be changed at first login.
QFLOW_ADMIN_USERNAME=admin
QFLOW_ADMIN_PASSWORD=

# Which reverse proxies may set X-Forwarded-For (used for rate limiting, login lockout and ALLOWED_API_IPS).
# Default: loopback, linklocal, uniquelocal  (a proxy on the same host or on a private network)
# Examples: TRUST_PROXY=false            (no proxy, clients connect directly)
#           TRUST_PROXY=192.168.1.10     (only this proxy)
#           TRUST_PROXY=1                (exactly one proxy hop, whatever its address)
TRUST_PROXY=

# Content-Security-Policy for the app (0/1). Test all screens after enabling.
ENABLE_CSP=0

# Maximum number of waiting tickets before new tickets are refused (protects against ticket spam)
MAX_WAITING_TICKETS=500

# HTTP API requests per minute per IP
API_RATE_LIMIT_PER_MINUTE=100

# Retention: log files (days), backups (newest N files, and none older than N days)
LOG_RETENTION_DAYS=14
BACKUP_KEEP=14
BACKUP_RETENTION_DAYS=30

# API keys (comma-separated) for integrations that call /api/print-ticket without an admin login.
# Send the key in the X-API-Key header. The endpoint only prints on printers configured in the admin panel.
API_KEYS=

# Optional IP allowlist for /api/print-ticket and the backup API (comma-separated IPs or IPv4 CIDR ranges)
# Example: 192.168.1.0/24,10.0.0.5
ALLOWED_API_IPS=

# OAuth / OIDC sign-in (see docs/oauth-oidc-auth.md). Client IDs and secrets are normally entered in
# the admin panel (Settings -> Sign-in methods); the values here only seed a fresh install.
# The callback URLs must match the public address registered at the provider.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
OIDC_CALLBACK_URL=http://localhost:3000/auth/oidc/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
